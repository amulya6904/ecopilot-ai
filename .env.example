# Optional EnergyPlus Phase 4 configuration (Windows examples)
ENERGYPLUS_HOME=C:\EnergyPlusV26-1-0
ENERGYPLUS_EXECUTABLE=C:\EnergyPlusV26-1-0\energyplus.exe
ENERGYPLUS_IDD=C:\EnergyPlusV26-1-0\Energy+.idd
ENERGYPLUS_MODEL=energyplus\models\base\phase4_base_model.idf
ENERGYPLUS_WEATHER=energyplus\weather\phase4_weather.epw
ENERGYPLUS_OUTPUT_ROOT=energyplus\output\official
ENERGYPLUS_LOG_ROOT=energyplus\logs

# Phase 7 local Ollama live-demo limits
ECOPILOT_LLM_THINK=false
ECOPILOT_LLM_TIMEOUT_SECONDS=180
ECOPILOT_LLM_FINAL_TIMEOUT_SECONDS=180
ECOPILOT_AGENT_RUN_TIMEOUT_SECONDS=360
ECOPILOT_AGENT_MAX_TOOL_ROUNDS=4
ECOPILOT_AGENT_MAX_RETRIES=1
ECOPILOT_LLM_NUM_PREDICT=192
ECOPILOT_LLM_NUM_CTX=4096
